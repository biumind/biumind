---
import Logo from './Logo.astro';
import { useTranslations, getLocale } from '../i18n';

const locale = getLocale(Astro.url.pathname);
const t = useTranslations(locale);
---

<footer class="mt-24 border-t border-border-subtle bg-surface">
  <div class="container-page py-16">
    <div class="grid grid-cols-2 gap-10 md:grid-cols-4">
      <div class="col-span-2 md:col-span-1">
        <Logo />
        <p class="mt-3 max-w-[240px] text-[13px] leading-relaxed text-ink-secondary">
          {t.footer.tagline}
        </p>
      </div>

      <div>
        <h4 class="text-[13px] font-semibold text-ink">{t.footer.productCol}</h4>
        <ul class="mt-4 space-y-2.5">
          {
            t.footer.productLinks.map((item) =>
              item.href ? (
                <li>
                  <a
                    href={item.href}
                    {...(item.href === '/app' ? { target: '_blank', rel: 'noopener' } : {})}
                    class="text-[13px] text-ink-secondary transition-colors hover:text-ink"
                  >
                    {item.label}
                  </a>
                </li>
              ) : (
                <li>
                  <span class="text-[13px] text-ink-secondary">{item.label}</span>
                </li>
              )
            )
          }
        </ul>
      </div>

      <div>
        <h4 class="text-[13px] font-semibold text-ink">{t.footer.resourcesCol}</h4>
        <ul class="mt-4 space-y-2.5">
          {
            t.footer.resourcesLinks.map((item) => (
              <li>
                <a
                  href={item.href}
                  {...(item.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}
                  class="text-[13px] text-ink-secondary transition-colors hover:text-ink"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h4 class="text-[13px] font-semibold text-ink">{t.footer.companyCol}</h4>
        <ul class="mt-4 space-y-2.5">
          {
            t.footer.companyLinks.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-[13px] text-ink-secondary transition-colors hover:text-ink"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col items-start justify-between gap-3 border-t border-border-subtle pt-6 md:flex-row md:items-center"
    >
      <p class="text-[12px] text-ink-muted">{t.footer.copyright}</p>
      <p class="text-[12px] text-ink-muted">
        Built with <span class="text-[var(--purple)]">♥</span> in Beijing.
      </p>
    </div>
  </div>
</footer>
