---
// 启动 Splash —— 仅在 session 第一次访问时显示约 1.6s。
// 同一标签内后续路由 / 刷新不再触发。reduced-motion 用户直接跳过。
import BiuMark from './BiuMark.astro';
---

<div id="biu-splash" class="biu-splash" aria-hidden="true">
  <div class="biu-splash__inner">
    <BiuMark
      class="biu-splash__mark"
      prefix="biu-splash"
      inkColor="#18181B"
      circuitColor="var(--purple)"
    />
    <div class="biu-splash__text">BiuMind</div>
  </div>
</div>

<script>
  const KEY = 'biu_splash_seen';
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const el = document.getElementById('biu-splash');
  if (!el) {
    /* noop */
  } else if (reduce || sessionStorage.getItem(KEY)) {
    el.remove();
  } else {
    sessionStorage.setItem(KEY, '1');
    document.documentElement.classList.add('biu-splash-locked');
    requestAnimationFrame(() => el.classList.add('is-running'));
    window.setTimeout(() => {
      el.classList.add('is-leaving');
      window.setTimeout(() => {
        el.remove();
        document.documentElement.classList.remove('biu-splash-locked');
      }, 380);
    }, 1600);
  }
</script>

<style is:global>
  html.biu-splash-locked,
  html.biu-splash-locked body {
    overflow: hidden;
  }

  .biu-splash {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    background:
      radial-gradient(closest-side at 50% 50%, #EEEDFB 0%, #FAFAFA 60%, #FAFAFA 100%);
    transition: opacity 360ms ease, visibility 360ms ease;
  }
  .biu-splash.is-leaving {
    opacity: 0;
    visibility: hidden;
  }

  .biu-splash__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }

  .biu-splash__mark {
    width: 80px;
    height: auto;
    overflow: visible;
    filter: drop-shadow(0 24px 36px rgba(91, 91, 214, 0.22));
  }

  /* 进场前 */
  .biu-splash__head {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: 50% 100%;
    transform: scale(0.9);
  }
  .biu-splash__circuits {
    clip-path: inset(0 0 100% 0);
  }
  .biu-splash__circuit {
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }
  .biu-splash__hand {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: 50% 50%;
    transform: translate(8%, 6%);
  }
  .biu-splash__text {
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro SC", "PingFang SC", system-ui, sans-serif;
    font-weight: 600;
    font-size: 18px;
    letter-spacing: -0.04em;
    color: var(--ink);
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 380ms ease, transform 380ms ease;
  }

  /* is-running 触发进场 */
  .biu-splash.is-running .biu-splash__head {
    animation: biu-splash-head 0.6s cubic-bezier(0.34, 1.3, 0.64, 1) forwards;
  }
  .biu-splash.is-running .biu-splash__circuits {
    animation: biu-splash-reveal 0.7s cubic-bezier(0.65, 0, 0.35, 1) forwards;
    animation-delay: 0.35s;
  }
  .biu-splash.is-running .biu-splash__circuit--l { animation: biu-splash-circuit 0.4s cubic-bezier(0.34, 1.6, 0.64, 1) 0.45s backwards; }
  .biu-splash.is-running .biu-splash__circuit--m { animation: biu-splash-circuit 0.4s cubic-bezier(0.34, 1.6, 0.64, 1) 0.65s backwards; }
  .biu-splash.is-running .biu-splash__circuit--r { animation: biu-splash-circuit 0.4s cubic-bezier(0.34, 1.6, 0.64, 1) 0.85s backwards; }
  .biu-splash.is-running .biu-splash__hand {
    animation: biu-splash-hand 0.55s cubic-bezier(0.5, 0, 0.2, 1) forwards;
    animation-delay: 0.7s;
  }
  .biu-splash.is-running .biu-splash__text {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.95s;
  }

  @keyframes biu-splash-head {
    0%   { opacity: 0; transform: scale(0.9); }
    100% { opacity: 1; transform: scale(1); }
  }
  @keyframes biu-splash-reveal {
    0%   { clip-path: inset(0 0 100% 0); }
    100% { clip-path: inset(0 0 0 0); }
  }
  @keyframes biu-splash-circuit {
    0%   { opacity: 0; transform: translateY(8%) scale(0.7); }
    70%  { opacity: 1; transform: translateY(-2%) scale(1.06); }
    100% { opacity: 1; transform: translateY(0) scale(1); }
  }
  @keyframes biu-splash-hand {
    0%   { opacity: 0; transform: translate(8%, 6%) rotate(-4deg); }
    100% { opacity: 1; transform: translate(0, 0) rotate(0); }
  }
</style>
