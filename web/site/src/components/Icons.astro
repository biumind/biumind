---
// 集中放页面内使用的 inline SVG 图标。每个图标都是无依赖的纯 path。
interface Props {
  name:
    | 'brain'
    | 'code'
    | 'hub'
    | 'creation'
    | 'cloud'
    | 'channel'
    | 'apps'
    | 'desktop'
    | 'mobile'
    | 'browser'
    | 'cli';
  class?: string;
}
const { name, class: className = 'h-5 w-5' } = Astro.props;
---

{
  name === 'brain' && (
    <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M9 4a3 3 0 0 0-3 3v.5A3 3 0 0 0 4 11a3 3 0 0 0 1.5 2.6V14a3 3 0 0 0 3 3h.5V20a1 1 0 0 0 2 0v-3.01M15 4a3 3 0 0 1 3 3v.5A3 3 0 0 1 20 11a3 3 0 0 1-1.5 2.6V14a3 3 0 0 1-3 3H15v3a1 1 0 1 1-2 0V4.99" />
      <path d="M9 4a3 3 0 0 1 6 0M9 11h2m4 0h-2" />
    </svg>
  )
}
{
  name === 'code' && (
    <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m9 8-4 4 4 4M15 8l4 4-4 4M13 6l-2 12" />
    </svg>
  )
}
{
  name === 'hub' && (
    <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="3" />
      <circle cx="5" cy="5" r="2" />
      <circle cx="19" cy="5" r="2" />
      <circle cx="5" cy="19" r="2" />
      <circle cx="19" cy="19" r="2" />
      <path d="m6.5 6.5 3 3M14.5 9.5l3-3M9.5 14.5l-3 3M14.5 14.5l3 3" />
    </svg>
  )
}
{
  name === 'cloud' && (
    <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M7 18a5 5 0 1 1 .9-9.92A6 6 0 0 1 19 11.5 4.5 4.5 0 0 1 18.5 18H7Z" />
      <path d="M12 11v6m-2-2 2 2 2-2" />
    </svg>
  )
}
{
  name === 'channel' && (
    <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z" />
    </svg>
  )
}
{
  name === 'creation' && (
    <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m15 4 1 2.5L18.5 7.5 16 8.5 15 11l-1-2.5L11.5 7.5 14 6.5 15 4Z" />
      <path d="M5 19 14 10" />
      <path d="m6.5 13 .6 1.5L8.5 15l-1.4.6L6.5 17l-.6-1.4L4.5 15l1.4-.5L6.5 13Z" />
    </svg>
  )
}
{
  name === 'apps' && (
    <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="3" width="7" height="7" rx="1" />
      <rect x="14" y="3" width="7" height="7" rx="1" />
      <rect x="3" y="14" width="7" height="7" rx="1" />
      <rect x="14" y="14" width="7" height="7" rx="1" />
    </svg>
  )
}

{
  name === 'desktop' && (
    <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="4" width="18" height="12" rx="2" />
      <path d="M9 20h6m-3-4v4" />
    </svg>
  )
}
{
  name === 'mobile' && (
    <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="7" y="2" width="10" height="20" rx="2" />
      <line x1="11" y1="18" x2="13" y2="18" />
    </svg>
  )
}
{
  name === 'browser' && (
    <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="4" width="18" height="16" rx="2" />
      <path d="M3 9h18" />
      <circle cx="7" cy="6.5" r="0.5" fill="currentColor" />
    </svg>
  )
}
{
  name === 'cli' && (
    <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="4" width="18" height="16" rx="2" />
      <path d="m7 9 3 3-3 3M13 15h4" />
    </svg>
  )
}
