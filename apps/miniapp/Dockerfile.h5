ARG INFRA_REGISTRY=docker.io
# BiuMind MiniApp — H5 build, multi-stage.
#
# Stage 1: pnpm install + uni-app build:h5 → dist/build/h5/
# Stage 2: nginx:1.27-alpine 静态托管 (跟 admin / web-client 同套).
#
# 路径前缀方案: 用户访问 https://your-biumind.example.com/m/ → SPA.
# web/site nginx 用 rewrite ^/m/(.*)$ /$1 break + proxy_pass 把前缀剥掉,
# 容器内 nginx 在 root 提供, 跟 dev 一致.
# Vite base + uni-app router base 两处都设成 /m/, 让浏览器拿到的资源
# URL 与 vue-router pathname 都带 /m/ 前缀, 落回 site 该 location 转回来.
#
# Build (root context = apps/miniapp/):
#   docker build -f Dockerfile.h5 --build-arg BASE=/m/ -t biumind/miniapp-h5:dev .

ARG BASE=/m/

FROM ${INFRA_REGISTRY}/library/node:22-alpine AS builder
ARG BASE
WORKDIR /app

# 国内 npm 镜像 — 与 admin / website 子项目对齐
ENV NPM_CONFIG_REGISTRY=https://registry.npmmirror.com

RUN corepack enable && corepack prepare pnpm@9.x --activate

# 单独一层装依赖, 利用 docker layer cache
COPY package.json pnpm-lock.yaml* ./
RUN pnpm install --frozen-lockfile=false --prefer-offline

# 拷源码 + 构建. UNI_H5_BASE / VITE_BASE 由 vite.config.ts + manifest.json
# 共同消费, 写到资源 URL 与 vue-router base.
COPY . .
ENV UNI_H5_BASE=${BASE}
RUN pnpm build:h5

# ── runtime ──────────────────────────────────────────────
FROM ${INFRA_REGISTRY}/library/nginx:1.27-alpine

# 升级 openssl（libcrypto3/libssl3 ≥3.3.7-r0）—— 基础镜像自带 3.3.3-r0 有 CRITICAL CVE-2026-31789
RUN apk upgrade --no-cache libcrypto3 libssl3

# 显式清掉 proxy 环境变量 — Jenkinsfile 给 build stage 传 http_proxy 拉国外资源,
# alpine wget 健康检查走 proxy 会 false-fail.
ENV http_proxy= https_proxy= HTTP_PROXY= HTTPS_PROXY= \
    no_proxy= NO_PROXY= all_proxy= ALL_PROXY=

RUN rm -f /etc/nginx/conf.d/default.conf && \
    rm -rf /usr/share/nginx/html/*

# uni-app build:h5 输出在 dist/build/h5/
COPY --from=builder /app/dist/build/h5 /usr/share/nginx/html
COPY nginx.h5.conf /etc/nginx/conf.d/biumind-miniapp-h5.conf

EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s \
    CMD wget -q --spider http://localhost/healthz || exit 1
