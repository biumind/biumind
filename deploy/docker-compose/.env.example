# BiuMind 测试环境配置
# 复制为 .env 后修改；docker compose 自动读取

# ─── 通用 ───────────────────────────────────────────────
COMPOSE_PROJECT_NAME=biumind
BIUMIND_ENV=test
BIUMIND_LOG_LEVEL=debug
TZ=Asia/Shanghai

# ─── 端口（如本机有冲突可改） ─────────────────────────
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
NATS_PORT=4222
NATS_MONITOR_PORT=8222
MODEL_RELAY_PORT=7001
RUNTIME_PORT=7002
BRAIN_PORT=7003
IDENTITY_PORT=7004
CHANNELS_PORT=7007
REALTIME_PORT=7008
AUTHZ_PORT=7009

# ─── Postgres ─────────────────────────────────────────
POSTGRES_USER=biumind
POSTGRES_PASSWORD=biumind_dev_password_change_me
POSTGRES_DB=biu_core

# ─── MinIO ────────────────────────────────────────────
MINIO_ROOT_USER=biumind
MINIO_ROOT_PASSWORD=biumind_minio_dev
MINIO_BUCKET=biumind

# ─── BYOK / 加密 ─────────────────────────────────────
# 生产用 KMS DataKey；测试用 base64 32 字节
# 生成命令: openssl rand -base64 32
BIUMIND_MASTER_KEY=Yml1bWluZC1kZXYtbWFzdGVyLWtleS0wMTIzNDU2Nzg=

# JWT 签名（测试用 HS256；生产用 RS256 + KMS）
JWT_SECRET=biumind_jwt_dev_secret_at_least_32_chars_change_me
JWT_ISSUER=https://identity.biumind.local
JWT_AUDIENCE=biumind-api

# ─── 会话生命周期 (BiuMind-Identity-Session-Design) ──────
# Access JWT TTL: dev 24h（避免本地开发频繁触发 refresh）;prod 建议 1h
# Refresh sliding TTL: 90d（每次 /v1/auth/refresh 续期到 now+sliding）
# Refresh absolute TTL: 1y（首次签发定死, rotation 不重置, 防永久泄漏）
# 详见 docs/BiuMind-Identity-Session-Design.md §五
IDENTITY_ACCESS_TTL=24h
IDENTITY_REFRESH_TTL=2160h
IDENTITY_REFRESH_ABSOLUTE_TTL=8760h
# Refresh rotation 宽限窗口: rotate 后窗口内重放老 rt 沿 rotated_to 链找回
# head 直接 200, 不判 token_reuse 整族撤销 (Auth0 Reuse Interval 同款)
IDENTITY_REFRESH_REUSE_GRACE=10s

# ─── 平台 LLM 池（可选；BYOK 已够用） ────────────────
# 模型 key 走 admin 后台落库；此处仅保留 compose 引用的 anthropic 兜底
BIUMIND_ANTHROPIC_KEY=

# ─── SearxNG（可选：自行部署的搜索实例，配置后 brain 启用 websearch） ─
# SEARXNG_URL=http://your-searxng:8080

# ─── Channels（可选） ────────────────────────────────
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
BIUMIND_ANTHROPIC_BASE_URL=

# ─── AIGC（文生图 / 文生视频 / 数字人 / 爆款解析） ─────
# 服务端口
AIGC_PORT=7012
# 上游模型 provider keys（P3 才需要；不填 worker 会拒收任务）
DASHSCOPE_API_KEY=
# 火山豆包 Ark 单 API key (Doubao Seedream / Seedance)
VOLCENGINE_ARK_API_KEY=

# ─── W1: 计费 + BYOK ──────────────────────────────────
# 服务间共享 bearer (model-relay / aigc 调 identity /v1/internal/* 用).
# 必须 identity 与 model-relay 配同一个值.
IDENTITY_INTERNAL_TOKEN=biumind-dev-internal-token-change-me
# BYOK (Bring Your Own Key) 主密钥, base64 32 字节.
# 生成: openssl rand -base64 32
# 严禁进 git; 旋转后旧密文无法解密.
BYOK_MASTER_KEY=
